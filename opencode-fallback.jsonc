{
  // STRICT BIG-PICKLE MODE (2026-08-07).
  // Config for the opencode-runtime-fallback plugin (https://github.com/youngbinkim0/opencode-fallback).
  //
  // USER RULE: ONLY opencode/big-pickle is allowed to answer. When the Zen free
  // IP limit is reached, opencode must NOT switch to any other model.
  //
  // The fallback chain is deliberately EMPTY:
  //   - When big-pickle hits the limit, the plugin logs "Provider retry detected"
  //     (the WARP watcher's rotation trigger) and then shows a "Provider
  //     Retrying (no fallback models configured)" toast -- it does NOT replay the
  //     turn on another model (plugin dist/index.js: fallbackModels.length === 0
  //     -> return without dispatch).
  //   - No model EVER serves a reply other than big-pickle.
  //   - The WARP watcher rotates the IP, then you re-send the message manually;
  //     big-pickle answers from the fresh IP.
  //
  // Previous "BIG-PICKLE-ONLY" mode (2026-08-06) kept a chain of opencode/*-free
  // models as rotation triggers. In practice one of them (nemotron-3-ultra-free)
  // DID serve replies during the window (seen 2026-08-07 15:54 UTC) -- the user
  // said stop: never change to any other model.
  "enabled": true,

  // HTTP status codes that trigger a fallback to the next model.
  "retry_on_errors": [429, 500, 502, 503, 504],

  // Extra regex patterns (case-insensitive) matching Zen's "free usage exceeded" errors
  // plus the common phrasing used by OpenRouter/Google rate limiters.
  "retryable_error_patterns": [
    "free usage",
    "free model limit",
    "free tier limit",
    "free usage limit",
    "rate limit",
    "FreeUsageLimitError",
    "too many requests",
    "quota exceeded",
    "insufficient quota",
    "try again later",
    "overloaded"
  ],

  // With an empty chain no fallback attempts happen; kept for forwards-compat.
  "max_fallback_attempts": 10,

  // WARP rotation is verified ~30-45s; 180s is a safe manual-retry cadence.
  "cooldown_seconds": 180,

  // Abort a fallback model if no token within 90s (unused with an empty chain).
  "timeout_seconds": 90,

  // Toast when the provider retries -- shows "Provider Retrying (no fallback
  // models configured)" so you know the limit was hit and WARP is rotating.
  "notify_on_fallback": true,

  // EMPTY ON PURPOSE: no other model is ever allowed to answer. See header.
  "fallback_models": []
}

// OPTIONAL RECOVERY LANES - if you ever want a REAL (non-big-pickle) fallback
// to serve replies, uncomment a block AFTER adding the provider key via
// `opencode auth login` (guide: README.md "Adding free provider lanes").
// These give independent, high-volume free quotas:
//
// Groq (free key: https://console.groq.com/keys, ~1K-14.4K req/day):
//   "groq/gpt-oss-20b",
//   "groq/llama-4-scout-17b-16e-instruct",
// Cerebras (free key: https://cloud.cerebras.ai, 30 RPM, 1M tokens/day):
//   "cerebras/qwen3-235b-a22b",
// NVIDIA NIM (free key: https://build.nvidia.com, ~40 RPM, no card):
//   "nvidia/glm-5.1",
//   "nvidia/kimi-k2.6",
// GitHub Copilot free (already authed on this machine; 50 premium req/month):
//   "copilot/gpt-4.1"  (model id depends on the Copilot plan exposed by opencode)
//
// NOTE: opencode-go/* and kimi-for-coding/* are NOT free on this account
// (verified 2026-08-04: Go needs a payment method, Kimi key is expired).
